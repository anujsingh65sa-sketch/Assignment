<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Navbar</title>
<style>
*,*::before,*::after { box-sizing: border-box; }

body {
  margin: 0;
  background: #f4f4f0;
  font-family: system-ui, sans-serif;
}

/* Navbar: logo on the left, menu on the right */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;   /* pushes logo left, menu right */
  align-items: center;              /* vertical centre */
  gap: 16px;
  padding: 12px 24px;
  background: #1f2937;
  color: #fff;
  border-bottom: 3px solid #0f766e;
}

.navbar__logo {
  font-size: 1.25rem;
  font-weight: 700;
  color: #fff;
  text-decoration: none;
}

/* Right side: links + button in one flex row */
.navbar__menu {
  display: flex;
  align-items: center;
  gap: 24px;
}

.navbar__links {
  display: flex;
  gap: 20px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.navbar__link {
  padding: 6px 2px;
  color: #d1d5db;
  text-decoration: none;
  border-bottom: 2px solid transparent;
}
.navbar__link:hover,
.navbar__link--active {
  color: #fff;
  border-bottom-color: #14b8a6;
}

