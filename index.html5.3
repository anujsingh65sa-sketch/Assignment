
<!DOCTYPE html>
<html>
<head>
  <title>CSS Typography</title>

  <!-- Google Font: Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap"
        rel="stylesheet">

  <style>
    /* Body styling */
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #f0f4ff;
      color: #333333;
      font-size: 16px;
      line-height: 1.6;
    }

    /* Heading */
    h1 {
      color: #2563eb;
      font-size: 36px;
      line-height: 1.2;
    }

    /* Paragraph */
    p {
      color: #555555;
      font-size: 18px;
      line-height: 1.8;
    }

    /* Card */
    .card {
      background-color: white;
      padding: 20px;
      border-radius: 10px;
    }

    /* Hero section */
    #hero {
      color: #7c3aed;
      font-size: 24px;
    }
  </style>
</head>

<body>

  <div class="card">
    <h1>Welcome to CSS!</h1>
    <p id="hero">Learn fonts, colours and typography.</p>
    <p>Google Fonts makes websites look beautiful.</p>
  </div>

</body>
</html>
