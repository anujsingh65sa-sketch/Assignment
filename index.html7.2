*,*::before,*::after { box-sizing: border-box; }

body {
  margin: 0;
  background: #f4f4f0;
  font-family: system-ui, sans-serif;
}

/* Navbar */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 12px 24px;
  background: #1f2937;
  color: #fff;
  border-bottom: 3px solid #0f766e;
}
.navbar__logo { font-size: 1.25rem; font-weight: 700; color: #fff; text-decoration: none; }
.navbar__menu { display: flex; align-items: center; gap: 24px; }
.navbar__links { display: flex; gap: 20px; margin: 0; padding: 0; list-style: none; }
