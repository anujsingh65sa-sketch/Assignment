<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Profile cards</title>
<style>
*,*::before,*::after { box-sizing: border-box; }

body {
  margin: 0;
  background: #f4f4f0;
  font-family: system-ui, sans-serif;
}

/* Layers (low to high):
   cards = 1, top bar = 100, + button = 200 */

/* Sticky top bar */
.topbar {
  position: sticky;
  top: 0;                    /* sticks when it reaches the top edge */
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 24px;
  background: #1f2937;
  color: #fff;
  border-bottom: 3px solid #0f766e;
}
.topbar h1 { margin: 0; font-size: 1.1rem; }
.topbar span { font-size: .85rem; opacity: .8; }

/* Cards area */
main {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 24px;
  padding: 24px;
}

.card {
  --accent: #0f766e;
  --tint: #ccfbf1;

  position: relative;
