
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CSS Grid and Flexbox</title>

  <style>
    * {
      box-sizing: border-box;
    }

    .container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      grid-template-areas:
        "head head"
        "side main"
        "foot foot";
      gap: 15px;
      padding: 20px;
    }

    .head {
      grid-area: head;
      background: steelblue;
    }

    .side {
      grid-area: side;
      background: orange;
    }

    .main {
      grid-area: main;
      background: seagreen;
    }

    .foot {
      grid-area: foot;
      background: gray;
    }

    .container > * {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 25px;
      color: white;
      border-radius: 8px;
      font-size: 18px;
    }

    .container span {
      font-size: 25px;
    }

    @media (max-width: 500px) {
      .container {
        grid-template-columns: 1fr;
        grid-template-areas:
          "head"
          "side"
          "main"
          "foot";
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <header class="head">
      <span>🏠</span> Header
    </header>

    <aside class="side">
      <span>📁</span> Sidebar
    </aside>

    <main class="main">
      <span>📄</span> Main Content
    </main>

    <footer class="foot">
      <span>📞</span> Footer
    </footer>

  </div>

</body>
</html>
