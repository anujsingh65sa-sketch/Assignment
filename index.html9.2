
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Responsive Grid Layout</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-size: 1rem;
      font-family: Arial, sans-serif;
    }

    /* Images fit their containers */
    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    /* Mobile first */
    .container {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "side"
        "main"
        "foot";
      gap: 1rem;
      padding: 1rem;
    }

    .head {
      grid-area: head;
      background: steelblue;
    }

    .side {
      grid-area: side;
      background: orange;
    }

    .main {
      grid-area: main;
      background: seagreen;
    }

    .foot {
      grid-area: foot;
      background: gray;
    }

    .container > * {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1.5rem;
      color: white;
      border-radius: 0.5rem;
      font-size: 1.125rem;
    }

    .container span {
      font-size: 1.5rem;
    }

    /* Tablet */
    @media (min-width: 768px) {
      .container {
        grid-template-columns: 12.5rem 1fr;
        grid-template-areas:
          "head head"
          "side main"
          "foot foot";
      }
    }

    /* Desktop */
    @media (min-width: 1024px) {
      .container {
        grid-template-columns: 15.625rem 1fr;
        gap: 1.25rem;
        padding: 1.5625rem;
      }

      .container > * {
        padding: 2rem;
        font-size: 1.25rem;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <header class="head">
      <span>🏠</span> Header
    </header>

    <aside class="side">
      <span>📁</span> Sidebar
    </aside>

    <main class="main">
      <span>📄</span> Main Content
      <img src="https://placehold.co/600x300" alt="Sample content">
    </main>

    <footer class="foot">
      <span>📞</span> Footer
    </footer>

  </div>

</body>
</html>
